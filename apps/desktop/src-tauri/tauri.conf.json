{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Vyn Studio",
  "version": "0.1.0",
  "identifier": "studio.vyn.app",
  "build": {
    "beforeDevCommand": "pnpm run web:dev",
    "devUrl": "http://localhost:3000",
    "beforeBuildCommand": "pnpm run web:build",
    "frontendDist": "../../web/out"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Vyn Studio",
        "width": 1280,
        "height": 800,
        "minWidth": 900,
        "minHeight": 600,
        "decorations": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}

{
  "name": "vyn-studio-vscode",
  "displayName": "Vyn Studio",
  "description": "Browse, search, and visualize your vector databases (Qdrant, Pinecone, Weaviate, Chroma, Milvus) without leaving your editor.",
  "version": "0.0.1",
  "private": true,
  "publisher": "vyn",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Other",
    "Visualization"
  ],
  "main": "./dist/extension.js",
  "activationEvents": [],
  "contributes": {
    "commands": [
      {
        "command": "vyn.open",
        "title": "Vyn Studio: Open"
      }
    ]
  },
  "scripts": {
    "build": "pnpm run build:ui && pnpm run build:host",
    "build:host": "node esbuild.js",
    "build:ui": "vite build --config webview-ui/vite.config.ts",
    "watch:host": "node esbuild.js --watch",
    "watch:ui": "vite build --watch --config webview-ui/vite.config.ts",
    "typecheck": "tsc --noEmit",
    "vscode:prepublish": "pnpm run build:ui && node esbuild.js --production"
  },
  "dependencies": {
    "@vyn/core": "workspace:*",
    "@vyn/viz": "workspace:*",
    "@tanstack/react-query": "^5.62.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "three": "^0.170.0",
    "umap-js": "^1.4.0",
    "zustand": "^5.0.2"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/three": "^0.170.0",
    "@types/vscode": "^1.85.0",
    "@vitejs/plugin-react": "^4.3.4",
    "esbuild": "^0.24.0",
    "typescript": "^5.6.0",
    "vite": "^6.0.0"
  }
}
